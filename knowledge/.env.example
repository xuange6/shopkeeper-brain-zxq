# --------------------------- Application ---------------------------
APP_NAME=Shopkeeper Brain
APP_DESCRIPTION=Hybrid RAG Knowledge Studio
APP_VERSION=2.0.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_CORS_ALLOW_CREDENTIALS=true

# Upload/task limits
MAX_UPLOAD_MB=100
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md,.markdown
IMPORT_UPLOAD_DIR=
TASK_TTL_SECONDS=86400

# ------------------------------ LLM -------------------------------
# Any OpenAI-compatible endpoint can be used.
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=replace-me
MODEL=your-chat-model
LLM_DEFAULT_MODEL=your-chat-model
ITEM_MODEL=your-json-capable-model
KG_MODEL=your-json-capable-model
VL_MODEL=your-vision-language-model
LLM_DEFAULT_TEMPERATURE=0
# Optional accounting rates used only for estimated evaluation cost.
LLM_INPUT_USD_PER_1M=0
LLM_OUTPUT_USD_PER_1M=0

# -------------------------- BGE models ----------------------------
BGE_M3=BAAI/bge-m3
BGE_M3_PATH=
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
EMBEDDING_DIM=1024

# ----------------------------- RAG -------------------------------
CHUNK_MAX_LENGTH=1200
CHUNK_MIN_LENGTH=300
CHUNK_OVERLAP_SENTENCES=1
RAG_MAX_CONTEXT_CHARS=12000
RAG_REFUSAL_MIN_SCORE=0.3
RAG_REFUSAL_MIN_CONFIDENCE=0.46
RAG_CAPABILITY_EVIDENCE_GUARD=true
RAG_CAPABILITY_AUTHORITATIVE_MIN_COVERAGE=0.5
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=10
RRF_K=60
RRF_KG_WEIGHT=0.7
RRF_MAX_RESULTS=20
RERANK_MIN_TOP_K=6
RERANK_MAX_TOP_K=15
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5
KG_ENTITY_ALIGN_MIN_SCORE=
KG_GRAPH_VERSION=legacy
KG_FAIL_ON_PARTIAL=true
KG_REQUIRE_NONEMPTY=true
IMPORT_GRAPH_ENABLE_KG=true
IMPORT_GRAPH_DUMP_FULL_STATE=false

# Trusted request identity / retrieval ACL. The API accepts only short-lived
# `Authorization: Shopkeeper <signed-token>` values minted by a trusted gateway.
# Use a randomly generated secret of at least 32 bytes; never commit the value.
ACCESS_DEFAULT_TENANT=public
ACCESS_CONTEXT_HMAC_SECRET=
RAG_ACL_POLICY_VERSION=retrieval-acl-v1

# ---------------------------- Milvus ------------------------------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=knowledge_chunks
ITEM_NAME_COLLECTION=knowledge_item_names
ENTITY_NAME_COLLECTION=knowledge_entity_names
INDEX_VERSION=unversioned
MILVUS_METRIC_TYPE=IP
MILVUS_MIN_COSINE_SCORE=0.3

# ----------------------------- Neo4j ------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# ----------------------------- Mongo ------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=shopkeeper_brain
MONGO_CHAT_COLLECTION=chat_message
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

# ----------------------------- MinIO ------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET_NAME=shopkeeper-brain
MINIO_SECURE=false

# -------------------------- Web search ----------------------------
MCP_DASHSCOPE_BASE_URL=
RAG_WEB_OFFICIAL_DOMAINS=
RAG_WEB_FRESHNESS_REQUIRE_OFFICIAL=true
RAG_WEB_OFFICIAL_QUERY_EXPANSION=true
RAG_WEB_OFFICIAL_QUERY_DOMAIN_LIMIT=3
