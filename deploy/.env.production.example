COMPOSE_PROJECT_NAME=shopkeeper-brain-production
SHOPKEEPER_IMAGE_TAG=stage3

APP_NAME=Shopkeeper Brain
APP_VERSION=3.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
APP_CORS_ORIGINS=https://knowledge.example.com
APP_CORS_ALLOW_CREDENTIALS=true

POSTGRES_DB=shopkeeper
POSTGRES_USER=shopkeeper
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__NEO4J_PASSWORD__
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G

MINIO_ROOT_USER=shopkeeper
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
MINIO_BUCKET_NAME=shopkeeper-brain
MINIO_SECURE=false

MONGO_DB_NAME=shopkeeper_brain
MONGO_CHAT_COLLECTION=chat_message
MONGO_USERNAME=shopkeeper_admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

CHUNKS_COLLECTION=knowledge_chunks_bootstrap
ENTITY_NAME_COLLECTION=knowledge_entities_bootstrap
ITEM_NAME_COLLECTION=knowledge_item_names
KG_GRAPH_VERSION=bootstrap
INDEX_VERSION=bootstrap

BGE_M3_PATH=/models/bge-m3
BGE_RERANKER_LARGE=/models/bge-reranker-large
MODEL_HOST_DIR=./models
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
EMBEDDING_DIM=1024

OPENAI_API_BASE=
OPENAI_API_KEY=
MODEL=
LLM_DEFAULT_MODEL=
ITEM_MODEL=
KG_MODEL=
VL_MODEL=
MCP_DASHSCOPE_BASE_URL=

LIFECYCLE_SCHEDULER_POLL_SECONDS=5
LIFECYCLE_WORKER_POLL_SECONDS=1
LIFECYCLE_WORKER_LEASE_SECONDS=60
LIFECYCLE_RECONCILE_INTERVAL_SECONDS=900
LIFECYCLE_AUTO_MIGRATE=true
LIFECYCLE_RELEASE_POINTER_MODE=file
DISTRIBUTED_RUNTIME=false
TASK_STATE_REDIS_URL=

ACCESS_DEFAULT_TENANT=public
RAG_ACL_POLICY_VERSION=retrieval-acl-v1
